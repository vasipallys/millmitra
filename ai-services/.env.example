# =============================================================================
# Rice Mill AI Services - Environment Configuration
# =============================================================================
# Copy this file to .env and update the values according to your environment
# Never commit .env files to version control!

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# FastAPI Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Service URLs
AI_SERVICES_URL=http://localhost:8000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# =============================================================================
# AI MODEL CONFIGURATION
# =============================================================================
# Google AI Platform (Gemini)
GOOGLE_AI_API_KEY=your-google-ai-api-key-here
GOOGLE_PROJECT_ID=your-google-project-id
GOOGLE_LOCATION=us-central1

# Gemini Model Configuration
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.7
GEMINI_TOP_P=0.8
GEMINI_TOP_K=40
GEMINI_SAFETY_SETTINGS=block_medium_and_above

# Gemini Vision (for image analysis)
GEMINI_VISION_MODEL=gemini-1.5-flash
GEMINI_VISION_MAX_IMAGES=16
GEMINI_VISION_IMAGE_QUALITY=auto

# Gemini Pro (for complex reasoning)
GEMINI_PRO_MODEL=gemini-1.5-pro
GEMINI_PRO_ENABLED=False

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# =============================================================================
# COMPUTER VISION MODELS
# =============================================================================
# Rice Quality Assessment
VISION_MODEL_PATH=models/rice_quality_model.h5
QUALITY_CONFIDENCE_THRESHOLD=0.85
IMAGE_PROCESSING_MAX_SIZE=1024

# Defect Detection
DEFECT_MODEL_PATH=models/defect_detection_model.h5
DEFECT_CONFIDENCE_THRESHOLD=0.75

# Grain Classification
GRAIN_CLASSIFIER_PATH=models/grain_classifier.h5
SUPPORTED_GRAIN_TYPES=basmati,jasmine,long_grain,short_grain,broken

# =============================================================================
# VOICE PROCESSING CONFIGURATION
# =============================================================================
# Speech Recognition
SPEECH_RECOGNITION_ENGINE=google
SPEECH_LANGUAGE=en-IN
SPEECH_TIMEOUT=10
SPEECH_PHRASE_TIME_LIMIT=30

# Text-to-Speech
TTS_ENGINE=google
TTS_LANGUAGE=en-IN
TTS_VOICE=en-IN-Wavenet-A
TTS_SPEED=1.0

# Voice Commands
VOICE_COMMANDS_ENABLED=True
VOICE_CONFIDENCE_THRESHOLD=0.8

# =============================================================================
# PREDICTIVE ANALYTICS
# =============================================================================
# Demand Forecasting
DEMAND_FORECAST_DAYS=30
DEMAND_MODEL_PATH=models/demand_forecast_model.pkl
SEASONAL_ADJUSTMENT=True

# Price Prediction
PRICE_PREDICTION_ENABLED=True
PRICE_MODEL_PATH=models/price_prediction_model.pkl
MARKET_DATA_SOURCES=local,national,international

# Yield Prediction
YIELD_PREDICTION_MODEL=models/yield_prediction_model.pkl
WEATHER_API_KEY=your-weather-api-key
SOIL_DATA_ENABLED=True

# =============================================================================
# NATURAL LANGUAGE PROCESSING
# =============================================================================
# Language Models
NLP_MODEL_PATH=models/rice_mill_nlp_model
LANGUAGE_DETECTION_ENABLED=True
SUPPORTED_LANGUAGES=en,hi,ta,te,kn

# Intent Recognition
INTENT_CONFIDENCE_THRESHOLD=0.7
MAX_INTENT_ALTERNATIVES=3

# Entity Extraction
ENTITY_EXTRACTION_ENABLED=True
CUSTOM_ENTITIES=rice_varieties,equipment_names,farmer_names

# =============================================================================
# MACHINE LEARNING PIPELINE
# =============================================================================
# Model Training
AUTO_RETRAIN_ENABLED=False
RETRAIN_SCHEDULE=weekly
MIN_TRAINING_SAMPLES=1000
MODEL_VALIDATION_SPLIT=0.2

# Feature Engineering
FEATURE_SCALING=standard
FEATURE_SELECTION_METHOD=mutual_info
MAX_FEATURES=100

# Model Monitoring
MODEL_DRIFT_DETECTION=True
PERFORMANCE_THRESHOLD=0.85
ALERT_ON_DEGRADATION=True

# =============================================================================
# DATA PROCESSING
# =============================================================================
# Image Processing
MAX_IMAGE_SIZE_MB=10
SUPPORTED_IMAGE_FORMATS=jpg,jpeg,png,bmp,tiff
IMAGE_PREPROCESSING_ENABLED=True
AUTO_CROP_ENABLED=True

# Audio Processing
MAX_AUDIO_SIZE_MB=50
SUPPORTED_AUDIO_FORMATS=wav,mp3,m4a,flac
AUDIO_SAMPLE_RATE=16000
NOISE_REDUCTION_ENABLED=True

# Data Validation
INPUT_VALIDATION_STRICT=True
DATA_SANITIZATION_ENABLED=True
OUTLIER_DETECTION_ENABLED=True

# =============================================================================
# CACHING CONFIGURATION
# =============================================================================
# Redis for AI Results Caching
REDIS_URL=redis://localhost:6379/4
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE_MB=500

# Model Caching
MODEL_CACHE_ENABLED=True
MODEL_CACHE_SIZE_GB=2
PRELOAD_MODELS=True

# =============================================================================
# PERFORMANCE OPTIMIZATION
# =============================================================================
# Async Processing
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT_SECONDS=300
BATCH_PROCESSING_ENABLED=True
MAX_BATCH_SIZE=100

# GPU Configuration
USE_GPU=False
GPU_MEMORY_LIMIT_MB=2048
MIXED_PRECISION_ENABLED=False

# CPU Optimization
MAX_WORKERS=4
THREAD_POOL_SIZE=8

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# Logging Configuration
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=logs/ai_services.log
LOG_ROTATION_SIZE_MB=100
LOG_RETENTION_DAYS=30

# Metrics Collection
METRICS_ENABLED=True
METRICS_ENDPOINT=/metrics
PROMETHEUS_PORT=9090

# Health Checks
HEALTH_CHECK_INTERVAL=60
MODEL_HEALTH_CHECK=True
DEPENDENCY_HEALTH_CHECK=True

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# API Security
API_KEY_REQUIRED=False
RATE_LIMITING_ENABLED=True
MAX_REQUESTS_PER_MINUTE=100

# Data Privacy
ANONYMIZE_LOGS=True
DATA_RETENTION_DAYS=90
PII_DETECTION_ENABLED=True

# Model Security
MODEL_ENCRYPTION_ENABLED=False
SECURE_MODEL_LOADING=True

# =============================================================================
# INTEGRATION SETTINGS
# =============================================================================
# Database Connection (for training data)
DATABASE_URL=postgresql://user:password@localhost:5432/ricemill
DB_POOL_SIZE=5
DB_TIMEOUT=30

# External APIs
WEATHER_API_URL=https://api.openweathermap.org/data/2.5
MARKET_DATA_API_URL=https://api.marketdata.com
NEWS_API_KEY=your-news-api-key

# Webhook Configuration
WEBHOOK_ENABLED=True
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_TIMEOUT=10

# =============================================================================
# RICE MILL SPECIFIC AI SETTINGS
# =============================================================================
# Quality Assessment Parameters
MOISTURE_CONTENT_ACCURACY=0.1
FOREIGN_MATTER_DETECTION_SENSITIVITY=0.95
BROKEN_GRAIN_THRESHOLD=5.0
COLOR_GRADING_ENABLED=True

# Production Optimization
YIELD_OPTIMIZATION_ENABLED=True
ENERGY_EFFICIENCY_TRACKING=True
WASTE_REDUCTION_TARGETS=0.02

# Farmer Analytics
FARMER_SCORING_WEIGHTS=quality:0.4,delivery:0.3,payment:0.2,relationship:0.1
CROP_ADVISORY_ENABLED=True
WEATHER_ALERTS_ENABLED=True

# =============================================================================
# EXPERIMENTAL FEATURES
# =============================================================================
# Beta Features (Use with caution)
EXPERIMENTAL_MODELS_ENABLED=False
ADVANCED_ANALYTICS_BETA=False
REAL_TIME_PROCESSING_BETA=False

# Research Mode
RESEARCH_MODE=False
DATA_COLLECTION_FOR_RESEARCH=False
ANONYMOUS_USAGE_STATS=True

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Development Tools
MOCK_AI_RESPONSES=False
SIMULATE_PROCESSING_DELAY=False
DEBUG_MODEL_OUTPUTS=False

# Testing
UNIT_TEST_MODE=False
INTEGRATION_TEST_MODE=False
LOAD_TEST_MODE=False

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# Uncomment for production deployment

# ENVIRONMENT=production
# DEBUG=False
# LOG_LEVEL=WARNING
# USE_GPU=True
# MODEL_CACHE_SIZE_GB=8
# MAX_CONCURRENT_REQUESTS=50
# RATE_LIMITING_ENABLED=True
# API_KEY_REQUIRED=True
# MODEL_ENCRYPTION_ENABLED=True

# =============================================================================
# DOCKER SPECIFIC SETTINGS
# =============================================================================
# When running in Docker containers

# BACKEND_URL=http://backend:5000
# DATABASE_URL=postgresql://user:password@db:5432/ricemill
# REDIS_URL=redis://redis:6379/4

# =============================================================================
# CLOUD DEPLOYMENT SETTINGS
# =============================================================================
# AWS Configuration
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# S3_MODEL_BUCKET=your-model-bucket

# Google Cloud Configuration
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# GCS_MODEL_BUCKET=your-model-bucket

# Azure Configuration
# AZURE_STORAGE_CONNECTION_STRING=your-azure-connection
# AZURE_CONTAINER_NAME=your-container
