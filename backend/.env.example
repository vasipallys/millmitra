    # =============================================================================
# Rice Mill AI - Backend Environment Configuration
# =============================================================================
# Copy this file to .env and update the values according to your environment
# Never commit .env files to version control!

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True

# Application URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
AI_SERVICES_URL=http://localhost:8000

# OpenTelemetry (Phoenix UI + OTLP HTTP on 6006; Jaeger/collector often 4318)
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:6006
OTEL_SERVICE_NAME=millmitra-api

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# IMPORTANT: Change these keys in production!
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# JWT Token Expiration (in hours/days)
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Password Security
BCRYPT_LOG_ROUNDS=12

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Choose one database type and comment out the others

# PostgreSQL Configuration (Primary)
DATABASE_URL=postgresql://rice_mill_user:secure_password@localhost:5432/rice_mill_erp

# MySQL Configuration (Alternative)
# DATABASE_URL=mysql://rice_mill_user:secure_password@localhost:3306/rice_mill_erp

# SQLite Configuration (Development/Testing only)
# DATABASE_URL=sqlite:///rice_mill_erp.db

# Database Connection Pool Settings
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_POOL_TIMEOUT=20
SQLALCHEMY_POOL_RECYCLE=300
SQLALCHEMY_MAX_OVERFLOW=0

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis for caching, sessions, and background tasks
REDIS_URL=redis://localhost:6379/0

# Redis Database Numbers (0-15)
REDIS_CACHE_DB=0
REDIS_SESSION_DB=1
REDIS_CELERY_DB=2

# =============================================================================
# AI SERVICES CONFIGURATION
# =============================================================================
# Google AI Platform
GOOGLE_AI_API_KEY=your-google-ai-api-key-here
GOOGLE_PROJECT_ID=your-google-project-id

# OpenAI (Optional)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo

# xAI Grok (farmer ID vision + /api/ai/grok/health). Also accepts GROK_API_KEY.
XAI_API_KEY=
XAI_MODEL=grok-2-latest

# AI Service Settings
AI_ENABLED=True
AI_TIMEOUT=30
AI_MAX_RETRIES=3

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# SMTP Settings
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@ricemill.com

# Email Templates
MAIL_SUBJECT_PREFIX=[Rice Mill AI]

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================
# Local File Storage
UPLOAD_FOLDER=uploads
TEMP_FOLDER=temp
LOG_FOLDER=logs

# File Size Limits (in bytes)
MAX_CONTENT_LENGTH=16777216  # 16MB
MAX_IMAGE_SIZE=5242880       # 5MB
MAX_DOCUMENT_SIZE=10485760   # 10MB

# Allowed File Extensions
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,bmp,webp
ALLOWED_DOCUMENT_EXTENSIONS=pdf,doc,docx,xls,xlsx,csv,txt

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
CACHE_TYPE=redis
CACHE_REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TIMEOUT=300  # 5 minutes
CACHE_KEY_PREFIX=rice_mill:

# =============================================================================
# SESSION CONFIGURATION
# =============================================================================
SESSION_TYPE=redis
SESSION_REDIS_URL=redis://localhost:6379/1
SESSION_PERMANENT=False
SESSION_USE_SIGNER=True
SESSION_KEY_PREFIX=rice_mill_session:
SESSION_COOKIE_SECURE=False  # Set to True in production with HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# =============================================================================
# CELERY CONFIGURATION (Background Tasks)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=Asia/Kolkata

# =============================================================================
# API RATE LIMITING
# =============================================================================
RATELIMIT_ENABLED=True
RATELIMIT_STORAGE_URL=redis://localhost:6379/3
RATELIMIT_DEFAULT=1000 per hour
RATELIMIT_LOGIN_ATTEMPTS=5 per minute
RATELIMIT_API_CALLS=100 per minute

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True
CORS_EXPOSE_HEADERS=Content-Range,X-Content-Range

# =============================================================================
# BUSINESS CONFIGURATION
# =============================================================================
# Company Information
COMPANY_NAME=Rice Mill AI
COMPANY_ADDRESS=Your Company Address Here
COMPANY_PHONE=+91-XXXXXXXXXX
COMPANY_EMAIL=info@ricemill.com
COMPANY_WEBSITE=https://ricemill.com

# Business Settings
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en_IN
TIMEZONE=Asia/Kolkata
FINANCIAL_YEAR_START=04-01  # April 1st (MM-DD)

# Tax Configuration
DEFAULT_TAX_RATE=0.18  # 18% GST
TAX_REGISTRATION_NUMBER=your-gst-number

# =============================================================================
# RICE MILL SPECIFIC CONFIGURATION
# =============================================================================
# Quality Standards
MOISTURE_CONTENT_MIN=12.0
MOISTURE_CONTENT_MAX=14.5
FOREIGN_MATTER_MAX=1.0
BROKEN_GRAINS_MAX=5.0
CHALKY_GRAINS_MAX=6.0

# Production Defaults
DEFAULT_BATCH_SIZE=1000  # kg
DEFAULT_PROCESSING_TIME=8  # hours
DEFAULT_YIELD_RATE=0.85  # 85%

# Inventory Thresholds
LOW_STOCK_THRESHOLD=100  # kg
CRITICAL_STOCK_THRESHOLD=50  # kg
REORDER_POINT_DAYS=7
SAFETY_STOCK_DAYS=3

# Pricing Configuration
PRICE_DECIMAL_PLACES=2
QUANTITY_DECIMAL_PLACES=3
WEIGHT_UNIT=kg
VOLUME_UNIT=liters

# =============================================================================
# FARMER MANAGEMENT
# =============================================================================
# Farmer Scoring Weights
FARMER_QUALITY_WEIGHT=0.4
FARMER_DELIVERY_WEIGHT=0.3
FARMER_PAYMENT_WEIGHT=0.2
FARMER_RELATIONSHIP_WEIGHT=0.1

# Payment Terms
DEFAULT_PAYMENT_TERMS_DAYS=30
ADVANCE_PAYMENT_PERCENTAGE=0.2  # 20%
QUALITY_BONUS_PERCENTAGE=0.05   # 5%

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================
# Equipment Monitoring
EQUIPMENT_CHECK_INTERVAL=3600  # 1 hour in seconds
MAINTENANCE_ALERT_DAYS=7
EQUIPMENT_EFFICIENCY_THRESHOLD=0.8  # 80%

# Quality Control
QUALITY_CHECK_FREQUENCY=4  # checks per batch
DEFECT_TOLERANCE_PERCENTAGE=0.02  # 2%
REWORK_THRESHOLD=0.05  # 5%

# =============================================================================
# SALES CONFIGURATION
# =============================================================================
# Customer Management
CUSTOMER_CREDIT_LIMIT_DEFAULT=100000  # INR
CUSTOMER_PAYMENT_TERMS_DEFAULT=30  # days
CUSTOMER_DISCOUNT_MAX=0.1  # 10%

# Order Processing
ORDER_CONFIRMATION_REQUIRED=True
AUTO_INVOICE_GENERATION=True
DELIVERY_TRACKING_ENABLED=True

# =============================================================================
# FINANCIAL CONFIGURATION
# =============================================================================
# Accounting
DOUBLE_ENTRY_ENABLED=True
AUTO_RECONCILIATION=True
FINANCIAL_YEAR_END=03-31  # March 31st

# Reporting
DAILY_REPORTS_ENABLED=True
WEEKLY_REPORTS_ENABLED=True
MONTHLY_REPORTS_ENABLED=True
ANNUAL_REPORTS_ENABLED=True

# =============================================================================
# COMPLIANCE CONFIGURATION
# =============================================================================
# Document Retention
AUDIT_RETENTION_DAYS=2555  # 7 years
DOCUMENT_RETENTION_DAYS=1825  # 5 years
TRANSACTION_LOG_RETENTION_DAYS=365  # 1 year

# Regulatory Compliance
FSSAI_LICENSE_NUMBER=your-fssai-license
ISO_CERTIFICATION=your-iso-certification
ORGANIC_CERTIFICATION=your-organic-certification

# =============================================================================
# MONITORING & ALERTING
# =============================================================================
# Health Checks
HEALTH_CHECK_ENABLED=True
HEALTH_CHECK_INTERVAL=300  # 5 minutes

# Performance Monitoring
PERFORMANCE_MONITORING_ENABLED=True
SLOW_QUERY_THRESHOLD=1000  # milliseconds
API_RESPONSE_TIME_THRESHOLD=2000  # milliseconds

# Error Tracking
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=development

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Database Backup
AUTO_BACKUP_ENABLED=True
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=backups/

# File Backup
FILE_BACKUP_ENABLED=True
FILE_BACKUP_FREQUENCY=weekly

# =============================================================================
# DEVELOPMENT/TESTING SETTINGS
# =============================================================================
# Testing
TESTING=False
TEST_DATABASE_URL=sqlite:///:memory:
WTF_CSRF_ENABLED=True

# Development Tools
FLASK_DEBUG_TB_ENABLED=False
SQLALCHEMY_ECHO=False  # Set to True to log SQL queries
PROFILING_ENABLED=False

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# Uncomment and modify these for production deployment

# FLASK_ENV=production
# FLASK_DEBUG=False
# SESSION_COOKIE_SECURE=True
# WTF_CSRF_ENABLED=True
# SQLALCHEMY_ECHO=False
# LOG_LEVEL=WARNING
# CORS_ORIGINS=https://yourdomain.com
# RATELIMIT_DEFAULT=500 per hour

# =============================================================================
# DOCKER SPECIFIC SETTINGS
# =============================================================================
# When running in Docker, use these service names instead of localhost

# DATABASE_URL=mysql://rice_mill_user:secure_password@db:3306/rice_mill_erp
# REDIS_URL=redis://redis:6379/0
# AI_SERVICES_URL=http://ai-services:8000

# =============================================================================
# CLOUD DEPLOYMENT SETTINGS
# =============================================================================
# AWS Settings
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET=your-s3-bucket

# Google Cloud Settings
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Azure Settings
# AZURE_STORAGE_CONNECTION_STRING=your-azure-connection-string
# AZURE_CONTAINER_NAME=your-container-name
